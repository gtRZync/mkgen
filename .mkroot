name: App_name
kind: exe #build kind (exe, static, shared) exe is the only one that's implemented for now
language: C++ #either C or C++ (and variants cpp, cplusplus..etc)

std: c++17 #compiler standard
compiler: clang++ #self explanatory
cflags: -Wall, -Werror

build_dir: build #build dir name
bin_dir: build/bin 
cross-platform: False

features: RAYLIB #features in supported features (e.g SDL2, SFML..etc)